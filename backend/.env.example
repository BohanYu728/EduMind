# ===== LLM 网关 =====
# stub（默认，无 key 可跑通骨架）/ dashscope / deepseek
LLM_PROVIDER=stub

# 阿里云百炼（DashScope）：LLM + 多模态 + Embedding + paraformer
DASHSCOPE_API_KEY=

# 录音转写：stub（默认，无 key 可跑）/ paraformer（阿里百炼录音文件识别，复用 DASHSCOPE_API_KEY）
ASR_PROVIDER=stub

# DeepSeek：LLM_PROVIDER=deepseek；文字/图片走云端，知识库特征向量在本地计算
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_VISION_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# SiliconFlow（embedding 备选，托管 bge-large-zh）
SILICONFLOW_API_KEY=

# MinerU PDF 解析（云端 API token，注册 mineru.net 获取）
MINERU_TOKEN=

# 博查网络搜索
BOCHA_API_KEY=

# ===== 数据库 =====
DATABASE_URL=sqlite:///./edumind.db
